# Copy to .env on the target host and replace every change-me value.
# Never commit .env. Generate independent random values for every secret.
COMPOSE_PROJECT_NAME=paperless-invoice-approval
APP_ENV=development
APP_BASE_URL=http://172.30.172.167
APP_SECRET_KEY=change-me-generate-at-least-32-random-bytes
DATABASE_URL=postgresql+psycopg://approval:change-me@postgres:5432/approval

# Shared PostgreSQL server, isolated databases and credentials.
POSTGRES_USER=approval
POSTGRES_PASSWORD=change-me
POSTGRES_DB=approval
KEYCLOAK_DB_PASSWORD=change-me
PAPERLESS_DB_PASSWORD=change-me

# Redis is dedicated to the isolated test Paperless instance.
REDIS_PASSWORD=change-me

# Keycloak public traffic goes through reverse-proxy:8081.
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://172.30.172.167:8081
KEYCLOAK_REALM=paperless-invoice
KEYCLOAK_CLIENT_ID=approval-app
KEYCLOAK_CLIENT_SECRET=change-me
PAPERLESS_OIDC_CLIENT_ID=paperless
PAPERLESS_OIDC_CLIENT_SECRET=change-me-use-a-different-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Synthetic test identities provisioned in Keycloak.
TEST_QUEUE_MANAGER_PASSWORD=change-me
TEST_APPROVER_1_PASSWORD=change-me
TEST_APPROVER_2_PASSWORD=change-me
TEST_APPROVER_3_PASSWORD=change-me

# Isolated Paperless-ngx test instance.
PAPERLESS_PUBLIC_URL=http://172.30.172.167:8000
PAPERLESS_BASE_URL=http://paperless:8000
PAPERLESS_SECRET_KEY=change-me-generate-at-least-64-random-bytes
PAPERLESS_ADMIN_USER=paperless-admin
PAPERLESS_ADMIN_PASSWORD=change-me
PAPERLESS_ADMIN_MAIL=paperless-admin@example.test
PAPERLESS_USERMAP_UID=1001
PAPERLESS_USERMAP_GID=1001
PAPERLESS_TIME_ZONE=Europe/Prague
PAPERLESS_OCR_LANGUAGE=ces+eng
PAPERLESS_OCR_LANGUAGES=ces slk
PAPERLESS_OCR_MODE=auto

# Runtime token is generated by paperless-bootstrap into a Docker volume.
# A manually managed token may be used only when PAPERLESS_API_TOKEN_FILE is empty.
PAPERLESS_API_TOKEN_FILE=/run/paperless-approval/api-token
PAPERLESS_API_TOKEN=
PAPERLESS_INBOX_TAG=Přijatá faktura
PAPERLESS_TAG_PROCESSING=AI zpracování
PAPERLESS_TAG_QUEUE_REVIEW=Kontrola správce
PAPERLESS_TAG_APPROVAL=Ke schválení
PAPERLESS_TAG_APPROVED=Schváleno
PAPERLESS_TAG_REJECTED=Zamítnuto
PAPERLESS_TAG_POHODA_READY=Připraveno pro Pohodu
PAPERLESS_TAG_EXPORTED=Exportováno
PAPERLESS_TAG_IMPORTED=Importováno do Pohody
PAPERLESS_TAG_APPROVED_COPY=Approval - schválená kopie
PAPERLESS_TAG_DUPLICATE=Duplicita
PAPERLESS_TAG_IGNORED=Ignorováno
ISDOC_MAX_ATTACHMENT_BYTES=4194304
ISDOC_XSD_PATH=/app/isdoc-xsd/isdoc-invoice-6.0.2.xsd
APPROVED_PDF_STAMP_VERSION=approval-stamp.v1
UPLOAD_MAX_BYTES=8388608

# CPU-only Ollama; one inference and one loaded model at a time.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_NUM_GPU=0
OLLAMA_KEEP_ALIVE=5m
AI_EXTRACTION_ENABLED=true
AI_EXTRACTION_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=3
PAPERLESS_SYNC_SECONDS=30

EXPORT_ARCHIVE_DIR=/data/exports
POHODA_XSD_PATH=/app/pohoda-xsd/data.xsd
POHODA_XSD_BUNDLE_VERSION=2025-10-16
POHODA_XML_ENCODING=Windows-1250
POHODA_GENERATOR_VERSION=pohoda-received-invoice.v3
# IČO cílové účetní jednotky POHODA; povinné pro nový XML export.
POHODA_TARGET_ICO=
# Volitelné. Pokud je prázdné, dataPack používá pouze IČO a atribut key nevznikne.
POHODA_TARGET_KEY=
ALLOCATION_TOLERANCE=0.01
