# Copy to .env and replace every change-me value. Never commit .env.
APP_ENV=development
APP_BASE_URL=http://localhost:8080
APP_SECRET_KEY=change-me-generate-at-least-32-random-bytes
DATABASE_URL=postgresql+psycopg://approval:change-me@postgres:5432/approval
POSTGRES_USER=approval
POSTGRES_PASSWORD=change-me
POSTGRES_DB=approval
KEYCLOAK_DB_PASSWORD=change-me

KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_REALM=paperless-invoice
KEYCLOAK_CLIENT_ID=paperless-invoice-app
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

TEST_QUEUE_MANAGER_PASSWORD=change-me
TEST_APPROVER_1_PASSWORD=change-me
TEST_APPROVER_2_PASSWORD=change-me
TEST_APPROVER_3_PASSWORD=change-me

PAPERLESS_BASE_URL=https://paperless.example.invalid
PAPERLESS_API_TOKEN=change-me
PAPERLESS_INBOX_TAG=invoice-received
PAPERLESS_TAG_PROCESSING=invoice-processing
PAPERLESS_TAG_QUEUE_REVIEW=invoice-queue-review
PAPERLESS_TAG_APPROVAL=invoice-approval
PAPERLESS_TAG_APPROVED=invoice-approved
PAPERLESS_TAG_REJECTED=invoice-rejected
PAPERLESS_TAG_POHODA_READY=pohoda-ready
PAPERLESS_TAG_EXPORTED=pohoda-exported
PAPERLESS_TAG_IMPORTED=pohoda-imported

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=180
WORKER_POLL_SECONDS=3
EXPORT_ARCHIVE_DIR=/data/exports
POHODA_XSD_PATH=/app/pohoda-xsd/data.xsd
ALLOCATION_TOLERANCE=0.01
