# Test deployment environment. Copy to .env and replace every change-me value.
# Required unless explicitly marked optional. Never commit .env.

# -----------------------------------------------------------------------------
# GENERAL / PUBLIC URLS / NETWORK
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=paperless-invoice-approval
APP_ENV=development
# Public hostnames or IP addresses reachable from users and Docker containers.
APP_BASE_URL=http://server.example.test
APPROVAL_HTTP_PORT=80
PAPERLESS_PUBLIC_URL=http://server.example.test:8000
PAPERLESS_HTTP_PORT=8000
KEYCLOAK_PUBLIC_URL=http://server.example.test:8081
KEYCLOAK_HTTP_PORT=8081
APP_SECRET_KEY=change-me-generate-at-least-32-random-characters

# -----------------------------------------------------------------------------
# POSTGRESQL / REDIS
# -----------------------------------------------------------------------------
# Approval, Keycloak and Paperless use isolated users/databases in one test DB server.
POSTGRES_USER=approval
POSTGRES_PASSWORD=change-me-independent-approval-db-password
POSTGRES_DB=approval
DATABASE_URL=postgresql+psycopg://approval:change-me-independent-approval-db-password@postgres:5432/approval
KEYCLOAK_DB_PASSWORD=change-me-independent-keycloak-db-password
PAPERLESS_DB_PASSWORD=change-me-independent-paperless-db-password
REDIS_PASSWORD=change-me-independent-redis-password

# -----------------------------------------------------------------------------
# KEYCLOAK / OIDC
# -----------------------------------------------------------------------------
# Internal service URL; do not point the test bootstrap at an external Keycloak.
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=paperless-invoice
KEYCLOAK_CLIENT_ID=approval-app
KEYCLOAK_CLIENT_SECRET=change-me-independent-approval-oidc-secret
PAPERLESS_OIDC_CLIENT_ID=paperless
PAPERLESS_OIDC_CLIENT_SECRET=change-me-independent-paperless-oidc-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-independent-keycloak-admin-password

# Synthetic test identities provisioned idempotently in Keycloak.
TEST_QUEUE_MANAGER_PASSWORD=change-me-independent-queue-manager-password
TEST_APPROVER_1_PASSWORD=change-me-independent-approver-one-password
TEST_APPROVER_2_PASSWORD=change-me-independent-approver-two-password
TEST_APPROVER_3_PASSWORD=change-me-independent-approver-three-password

# -----------------------------------------------------------------------------
# PAPERLESS-NGX
# -----------------------------------------------------------------------------
# Internal service URL; originals and OCR never use a production Paperless here.
PAPERLESS_BASE_URL=http://paperless:8000
PAPERLESS_SECRET_KEY=change-me-generate-at-least-64-random-characters-for-paperless
PAPERLESS_ADMIN_USER=paperless-admin
PAPERLESS_ADMIN_PASSWORD=change-me-independent-paperless-admin-password
PAPERLESS_ADMIN_MAIL=paperless-admin@example.test
# Set to the Linux uid/gid that should own Paperless files on the test host.
PAPERLESS_USERMAP_UID=1000
PAPERLESS_USERMAP_GID=1000
PAPERLESS_TIME_ZONE=Europe/Prague
PAPERLESS_OCR_LANGUAGE=ces+eng
PAPERLESS_OCR_LANGUAGES=ces slk
PAPERLESS_OCR_MODE=auto

# Generated by paperless-bootstrap into a protected Docker volume.
PAPERLESS_API_TOKEN_FILE=/run/paperless-approval/api-token
# Optional manual fallback. Leave empty for the standard test bootstrap.
PAPERLESS_API_TOKEN=

# -----------------------------------------------------------------------------
# PAPERLESS TECHNICAL TAGS
# -----------------------------------------------------------------------------
PAPERLESS_INBOX_TAG=Přijatá faktura
PAPERLESS_TAG_PROCESSING=AI zpracování
PAPERLESS_TAG_QUEUE_REVIEW=Kontrola správce
PAPERLESS_TAG_APPROVAL=Ke schválení
PAPERLESS_TAG_APPROVED=Schváleno
PAPERLESS_TAG_REJECTED=Zamítnuto
PAPERLESS_TAG_POHODA_READY=Připraveno pro Pohodu
PAPERLESS_TAG_EXPORTED=Exportováno
PAPERLESS_TAG_IMPORTED=Importováno do Pohody
PAPERLESS_TAG_APPROVED_COPY=Approval - schválená kopie
PAPERLESS_TAG_DUPLICATE=Duplicita
PAPERLESS_TAG_IGNORED=Ignorováno

# -----------------------------------------------------------------------------
# UPLOAD / ISDOC
# -----------------------------------------------------------------------------
UPLOAD_MAX_BYTES=8388608
ISDOC_MAX_ATTACHMENT_BYTES=4194304
ISDOC_XSD_PATH=/app/isdoc-xsd/isdoc-invoice-6.0.2.xsd
APPROVED_PDF_STAMP_VERSION=approval-stamp.v1

# -----------------------------------------------------------------------------
# OLLAMA / LOCAL AI
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_NUM_GPU=0
OLLAMA_KEEP_ALIVE=5m
AI_EXTRACTION_ENABLED=true
AI_EXTRACTION_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=3
PAPERLESS_SYNC_SECONDS=30

# -----------------------------------------------------------------------------
# POHODA / EXPORT
# -----------------------------------------------------------------------------
EXPORT_ARCHIVE_DIR=/data/exports
POHODA_XSD_PATH=/app/pohoda-xsd/data.xsd
POHODA_XSD_BUNDLE_VERSION=2025-10-16
POHODA_XML_ENCODING=Windows-1250
POHODA_GENERATOR_VERSION=pohoda-received-invoice.v3
# Optional for running the stack, but required before GENERATED_XML export.
# This is the target accounting unit IČO, never the supplier IČO.
POHODA_TARGET_ICO=
# Optional real accounting-unit GUID. Leave empty unless explicitly supplied by POHODA.
POHODA_TARGET_KEY=
ALLOCATION_TOLERANCE=0.01
